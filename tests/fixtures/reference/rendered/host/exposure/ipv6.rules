-A INPUT -p tcp --dport 22 -j DROP

# prometheus: loopback tcp/9090 (container_published, ipv6 terminates on INPUT)
-A INPUT -p tcp --dport 9090 -j DROP

# alertmanager: loopback tcp/9093 (container_published, ipv6 terminates on INPUT)
